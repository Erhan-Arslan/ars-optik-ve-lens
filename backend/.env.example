DATABASE_URL="postgresql://ars_optik:ars_optik_dev@localhost:5432/ars_optik_db?schema=public"
# Optional: direct (non-pooled) URL for migrations. For Neon it is derived from DATABASE_URL.
# DIRECT_DATABASE_URL=""
REDIS_URL="redis://localhost:6379"

# The .NET service validates these tokens too; HS256 there needs at least 32 bytes.
JWT_ACCESS_SECRET="dev-only-access-secret-change-me-32+chars"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

PORT=4000
CORS_ORIGIN="http://localhost:3000"

# Live admin order notifications via the .NET service (optional; disabled when unset).
DOTNET_SERVICE_URL="http://localhost:5000"
INTERNAL_API_KEY="dev-only-internal-api-key-32+chars"
NODE_ENV="development"
