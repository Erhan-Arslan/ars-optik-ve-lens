<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="11.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="11.0.0" />
    <!-- TODO: move to 11.0.0 once the Npgsql EF Core provider ships GA for .NET 11. -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="11.0.0-rc.3" />
    <PackageReference Include="QuestPDF" Version="2026.9.1" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.20.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Brand fonts and logo for PDF invoices; the runtime image has no system fonts. -->
    <EmbeddedResource Include="Invoices\Assets\Fonts\*.ttf" LogicalName="Invoices.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Invoices\Assets\logo.png" LogicalName="Invoices.logo.png" />
  </ItemGroup>

</Project>
